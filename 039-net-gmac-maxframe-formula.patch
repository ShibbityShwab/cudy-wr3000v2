-#define LUOFU_GMAC_MAX_FRAME_SLACK	4	/* [V] hi_mac_hw_mtu: mtu + 4 */
+/*
+ * hi_mac_hw_mtu(ctx, arg) stores (arg + 4) in the low 14 bits.  The vendor's
+ * default on this board is 1518 = 1500 (MTU) + 14 (Ethernet header) + 4 (the
+ * helper's own +4): the argument is the frame length without FCS, i.e.
+ * MTU + 14, and the register value MTU + 18 [I, cross-checked against the
+ * 1518 found default].  Patch 038 used MTU + 4 and wrote 1504 over the 1518
+ * default, which would mark every full-size frame as over-max in both
+ * directions; patch 039 fixes the formula and, additionally, never lowers the
+ * found limit (only raises it when the MTU needs more), so a hardware default
+ * larger than our formula cannot be clipped by mistake.
+ */
+#define LUOFU_GMAC_FRAME_OVERHEAD	14	/* [I] Ethernet header without FCS */
+#define LUOFU_GMAC_MAX_FRAME_SLACK	18	/* [V] header + hi_mac_hw_mtu +4 */
 
 #define LUOFU_GMAC_CTRL		0x0000
 #define LUOFU_GMAC_PORT_MODE	0x0040
